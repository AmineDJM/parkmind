# ─────────────────────────────────────────────────────────────────────────────
# Parkmind — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
# Local dev example:
#   postgresql://postgres:postgres@localhost:5432/parkmind
# Render/Supabase/Railway: paste the provided connection string (add ?sslmode=require if needed).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parkmind"

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL, used in emails/magic links and absolute redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Node environment (development | production | test)
NODE_ENV="development"

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs and one-time tokens. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"
# Session lifetime in days.
AUTH_SESSION_DAYS="30"

# ── Automation / Cron ───────────────────────────────────────────────────────
# Shared secret required to trigger the automation cron endpoint.
# The cron caller must send:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me-cron-secret"

# ── Financial safety defaults (can be overridden per user in the app) ────────
# Hard platform ceilings applied on top of user preferences (euros).
PLATFORM_DAILY_CAP_EUR="20"
PLATFORM_MONTHLY_CAP_EUR="200"
# Global kill switch. When "true", NO real or simulated session is ever started.
PARKMIND_KILL_SWITCH="false"
# When "true", every user defaults to Simulation Mode (no money spent).
DEFAULT_SIMULATION_MODE="true"

# ── Email (optional in MVP) ─────────────────────────────────────────────────
# Mailer driver: "console" (dev, logs to stdout + DB) | "smtp" | "resend"
MAIL_DRIVER="console"
MAIL_FROM="Parkmind <no-reply@parkmind.app>"
# SMTP (only if MAIL_DRIVER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Resend (only if MAIL_DRIVER=resend)
RESEND_API_KEY=""

# ── Billing (optional in MVP) ───────────────────────────────────────────────
# Stripe is optional; when keys are absent, billing runs in "disabled" mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=""

# ── Admin bootstrap ─────────────────────────────────────────────────────────
# Comma-separated emails that are granted the ADMIN role on signup/seed.
ADMIN_EMAILS="amine.djouamaii@gmail.com"
